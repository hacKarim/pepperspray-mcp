# PepperSpray v2 — Environment Configuration

# LLM provider: anthropic (default) | openai | ollama
LLM_PROVIDER=anthropic
# Model id (defaults to a current Claude model)
PEPPERSPRAY_MODEL=claude-opus-4-8

# Credentials (only the active provider's key is required)
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# PEPPERSPRAY_OLLAMA_BASE_URL=http://localhost:11434

# Execution
PEPPERSPRAY_COMMAND_TIMEOUT=300
PEPPERSPRAY_RESULTS_DIR=results
PEPPERSPRAY_STEP_BUDGET=12

# Optional: persistent checkpointer path (enables resumable runs)
# PEPPERSPRAY_CHECKPOINT_DB=checkpoints.sqlite

# Optional: LangSmith tracing (opt-in; off by default, nothing leaves the host)
# PEPPERSPRAY_LANGSMITH_TRACING=true
# PEPPERSPRAY_LANGSMITH_PROJECT=pepperspray
# PEPPERSPRAY_LANGSMITH_API_KEY=ls-...

# Optional third-party enrichment keys
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=
